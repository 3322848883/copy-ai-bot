# 依赖与构建产物（避免构建上下文过大）
.venv
venv
__pycache__
*.pyc
**/__pycache__
**/*.pyc
.pytest_cache
web-ui/node_modules
web-ui/.next
web-ui/out
web-admin/node_modules
web-admin/.next
web-admin/out
node_modules
**/node_modules
**/.next

# 测试与本地产物（后端镜像运行时不需要）
tests
playwright-report
test-results

# 本地数据（登录态/数据库/日志，不进镜像）
data
*.log
celerybeat-schedule.*
celerybeat.pid

# 文档与无关目录
docs
deploy

# 版本控制与 IDE
.git
.gitignore
.idea
.vscode
.DS_Store

# 密钥与环境变量（由 compose 注入）
.env
.env.local
